#!/bin/sh

echo "Configuring for Windows..."

# Follow flint package model: check user variables first, then use defaults
PKG_CPPFLAGS=""
PKG_LIBS=""

if test -n "$R_FLINT_CPPFLAGS"; then
    PKG_CPPFLAGS="$R_FLINT_CPPFLAGS -I./include -DHAVE_FLINT"
    PKG_LIBS="${R_FLINT_LIBS:-"-lflint -lmpfr -lgmp"}"
    echo "Using user-specified FLINT configuration"
else
    # Check common Windows FLINT locations
    for prefix in "${RTOOLS40_HOME}/usr" "${RTOOLS44_HOME}/usr" "${R_TOOLS_SOFT}" "/usr/local"; do
        if test -d "$prefix" && test -f "$prefix/include/flint/flint.h"; then
            echo "Found FLINT in $prefix"
            PKG_CPPFLAGS="-I$prefix/include -I./include -DHAVE_FLINT"
            PKG_LIBS="-L$prefix/lib -lflint -lmpfr -lgmp"
            break
        fi
    done

    # Default for Rtools44+
    if test -z "$PKG_CPPFLAGS"; then
        echo "Using Rtools default FLINT configuration"
        PKG_CPPFLAGS="-I./include -DHAVE_FLINT"
        PKG_LIBS="-lflint -lmpfr -lgmp"
    fi
fi

# Create standard Makevars (not Makevars.win)
cat > src/Makevars << EOF
PKG_CPPFLAGS = $PKG_CPPFLAGS
PKG_LIBS = $PKG_LIBS
OBJECTS = init.o r_interface.o builtin_functions.o
PKG_CFLAGS = -DHAVE_VISIBILITY_ATTRIBUTE
EOF

echo "Windows configuration complete"
