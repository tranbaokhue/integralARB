#!/bin/sh

echo "Configuring for Windows..."

PKG_CPPFLAGS=""
PKG_LIBS=""

# Check multiple Windows locations
for prefix in "${RTOOLS40_HOME}/usr" "${R_TOOLS_SOFT}" "/mingw64" "/usr/local" "C:/msys64/mingw64" "C:/vcpkg/installed/x64-windows"; do
    if [ -d "$prefix" ] && [ -f "$prefix/include/flint/flint.h" ]; then
        echo "Found FLINT in $prefix"
        PKG_CPPFLAGS="-I$prefix/include -I./include -DHAVE_FLINT"
        PKG_LIBS="-L$prefix/lib -lflint -lgmp -lmpfr -lm"
        break
    fi
done

if [ -z "$PKG_CPPFLAGS" ]; then
    echo "Error: FLINT not found on Windows"
    echo "Please install FLINT via MSYS2:"
    echo "  pacman -S mingw-w64-x86_64-flint"
    echo "Or see README for alternative installation methods"
    exit 1
fi

# Create Makevars.win
cat > src/Makevars.win << EOF
PKG_CPPFLAGS = $PKG_CPPFLAGS
PKG_LIBS = $PKG_LIBS
OBJECTS = init.o r_interface.o builtin_functions.o
PKG_CFLAGS = -DHAVE_VISIBILITY_ATTRIBUTE
EOF

echo "Windows configuration complete"
echo "CPPFLAGS: $PKG_CPPFLAGS"
echo "LIBS: $PKG_LIBS"
