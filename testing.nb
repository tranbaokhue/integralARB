        RowBox[{"0.01", ",", " ", "0.1"}], "}"}], ",", " ", "8", ",", " ", 
       "\"\<\[Integral]\:2080.\:2080\:2081^0.1 ln(x) dx\>\""}], "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Case", " ", "9"}], ":", " ", 
