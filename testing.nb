   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Case 16: \>\"", ",", " ", "exact16"}], "]"}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Export", " ", "exact", " ", "symbolic", " ", "forms"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<=== EXACT SYMBOLIC FORMS ===\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Case  1: \>\"", ",", " ", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"Sin", "[", "x", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "0", ",", " ", "Pi"}], "}"}]}], "]"}]}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Case  2: \>\"", ",", " ", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"Cos", "[", "x", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "0", ",", " ", 
          RowBox[{"Pi", "/", "2"}]}], "}"}]}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Case  3: \>\"", ",", " ", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"ArcTan", "[", "x", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Case  4: \>\"", ",", " ", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"Sinh", "[", "x", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Case  5: \>\"", ",", " ", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"Cosh", "[", "x", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]}], "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Case  6: \>\"", ",", " ", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"x", "^", "10"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", 
          RowBox[{"-", "6"}], ",", " ", "6"}], "}"}]}], "]"}]}], "]"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Case  7: \>\"", ",", " ", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"Exp", "[", "x", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", 
          RowBox[{"-", "10"}], ",", " ", "0"}], "}"}]}], "]"}]}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Case  8: \>\"", ",", " ", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"Log", "[", "x", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "0.01", ",", " ", "0.1"}], "}"}]}], "]"}]}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Case  9: \>\"", ",", " ", 
      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{"2", "*", "x"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "0", ",", " ", 
          RowBox[{"Pi", "/", "2"}]}], "}"}]}], "]"}]}], "]"}], ";"}], "\n", 
