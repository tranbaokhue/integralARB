       RowBox[{"(", "x", ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"exact2", " ", "=", " ", 
     RowBox[{"computeIntegral", "[", 
      RowBox[{
       RowBox[{"Cos", "[", "x", "]"}], ",", " ", "x", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", 
         RowBox[{"Pi", "/", "2"}]}], "}"}], ",", " ", "2", ",", " ", 
       "\"\<\[Integral]\:2080^(\[Pi]/2) cos(x) dx\>\""}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Case", " ", "3"}], ":", " ", 
     RowBox[{"ArcTan", " ", "integral"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"exact3", " ", "=", " ", 
     RowBox[{"computeIntegral", "[", 
      RowBox[{
       RowBox[{"ArcTan", "[", "x", "]"}], ",", " ", "x", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "3", ",", " ", 
       "\"\<\[Integral]\:2080\.b9 arctan(x) dx\>\""}], "]"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Case", " ", "4"}], ":", " ", 
     RowBox[{"Sinh", " ", "integral"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"exact4", " ", "=", " ", 
     RowBox[{"computeIntegral", "[", 
      RowBox[{
       RowBox[{"Sinh", "[", "x", "]"}], ",", " ", "x", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "4", ",", " ", 
       "\"\<\[Integral]\:2080\.b9 sinh(x) dx\>\""}], "]"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Case", " ", "5"}], ":", " ", 
     RowBox[{"Cosh", " ", "integral"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"exact5", " ", "=", " ", 
     RowBox[{"computeIntegral", "[", 
      RowBox[{
       RowBox[{"Cosh", "[", "x", "]"}], ",", " ", "x", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", "5", ",", " ", 
       "\"\<\[Integral]\:2080\.b9 cosh(x) dx\>\""}], "]"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Case", " ", "6"}], ":", " ", 
     RowBox[{"Polynomial", " ", "integral"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"exact6", " ", "=", " ", 
     RowBox[{"computeIntegral", "[", 
      RowBox[{
       RowBox[{"x", "^", "10"}], ",", " ", "x", ",", " ", 
