Cell[CellGroupData[{
Cell["Verifications of integrals evaluation", "Title",
 CellChangeTimes->{{3.966457662687134*^9, 
  3.966457672873724*^9}},ExpressionUUID->"a24edfc6-8880-4d2e-8104-\
83d8e723abb9"],

Cell["For comparison with integralARB package", "Subtitle",
 CellChangeTimes->{{3.966460790790414*^9, 
  3.96646080565758*^9}},ExpressionUUID->"0db03ae6-683c-4691-a7fa-\
e335480b9796"],

Cell[CellGroupData[{

Cell["Testing on September 10, 2025", "Section",
 CellChangeTimes->{{3.966460849806966*^9, 
  3.966460856647328*^9}},ExpressionUUID->"d60bcc1d-6328-40b7-8758-\
4223cce95bc3"],

Cell["\<\
We will test the precision of integralARB R package with 16 different \
integrals. The answer will range from integers to rational and irrational \
numbers to best evaluate the precision attainable by the package. With this \
mathematica notebook, we will try to solve each integral symbolically before \
getting the decimal representation in high precision to minimize errors in \
computation.\
\>", "Text",
 CellChangeTimes->{{3.9664608595466003`*^9, 
  3.966460974747651*^9}},ExpressionUUID->"c18ed33a-7b24-4afc-ad64-\
f1f1bc1dfd7e"],

Cell["\<\
Split the code by case. Put the overview with all the graph to the beginning.
\
\>", "Text",
 CellChangeTimes->{{3.9664609832582912`*^9, 
  3.966461003146364*^9}},ExpressionUUID->"acf5e2ab-db63-413a-a20f-\
bcfb7753588f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Set", " ", "high", " ", "precision", " ", "for", " ", "calculations"}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"$MaxExtraPrecision", " ", "=", " ", "200"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"precision", " ", "=", " ", "50"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Function", " ", "to", " ", "compute", " ", "integral", " ", 
      "symbolically", " ", "first"}], ",", " ", 
     RowBox[{"then", " ", "numerically", " ", "if", " ", "needed"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"computeIntegral", "[", 
      RowBox[{
      "integrand_", ",", " ", "var_", ",", " ", "limits_", ",", " ", 
       "caseNum_", ",", " ", "description_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "symbolic", ",", " ", "exact", ",", " ", "numerical", ",", " ", 
         "plot"}], "}"}], ",", "\n", "  ", "\n", "  ", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<=== Case \>\"", ",", " ", "caseNum", ",", " ", "\"\<: \>\"", 
          ",", " ", "description", ",", " ", "\"\< ===\>\""}], "]"}], ";", 
        "\n", "  ", "\n", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{"Try", " ", "symbolic", " ", "integration", " ", "first"}], 
         " ", "*)"}], "\n", "  ", 
        RowBox[{"symbolic", " ", "=", " ", 
         RowBox[{"Quiet", "[", 
          RowBox[{"Integrate", "[", 
           RowBox[{"integrand", ",", " ", 
            RowBox[{"{", 
             RowBox[{"var", ",", " ", 
              RowBox[{"limits", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
              RowBox[{"limits", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}], ";",
         "\n", "  ", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FreeQ", "[", 
           RowBox[{"symbolic", ",", " ", "Integrate"}], "]"}], ",", "\n", 
          "    ", 
          RowBox[{"(*", " ", 
           RowBox[{"Symbolic", " ", "integration", " ", "succeeded"}], " ", 
           "*)"}], "\n", "    ", 
          RowBox[{
           RowBox[{"exact", " ", "=", " ", 
            RowBox[{"N", "[", 
             RowBox[{"symbolic", ",", " ", "precision"}], "]"}]}], ";", "\n", 
           "    ", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Symbolic result: \>\"", ",", " ", "symbolic"}], 
            "]"}], ";", "\n", "    ", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<High precision value: \>\"", ",", " ", "exact"}], 
            "]"}]}], ",", "\n", "    ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"Symbolic", " ", "failed"}], ",", " ", 
            RowBox[{
             RowBox[{"use", " ", "high"}], "-", 
             RowBox[{"precision", " ", "numerical"}]}]}], " ", "*)"}], "\n", 
          "    ", 
          RowBox[{
           RowBox[{"exact", " ", "=", " ", 
            RowBox[{"NIntegrate", "[", 
             RowBox[{"integrand", ",", " ", 
              RowBox[{"{", 
               RowBox[{"var", ",", " ", 
                RowBox[{"limits", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                RowBox[{"limits", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", " ", "\n", 
              "           ", 
              RowBox[{"WorkingPrecision", " ", "->", " ", "precision"}]}], 
             "]"}]}], ";", "\n", "    ", 
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<Symbolic integration failed, using numerical: \>\"", ",", 
             " ", "exact"}], "]"}]}]}], "\n", "  ", "]"}], ";", "\n", "  ", 
        "\n", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{"Create", " ", "plot"}], " ", "*)"}], "\n", "  ", 
        RowBox[{"plot", " ", "=", " ", 
         RowBox[{"Plot", "[", 
          RowBox[{"integrand", ",", " ", 
           RowBox[{"{", 
            RowBox[{"var", ",", " ", 
             RowBox[{"limits", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
             RowBox[{"limits", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", " ", "\n", "    ", 
           RowBox[{"PlotStyle", " ", "->", " ", "Blue"}], ",", " ", "\n", 
           "    ", 
           RowBox[{"Filling", " ", "->", " ", "Axis"}], ",", " ", "\n", 
           "    ", 
           RowBox[{"FillingStyle", " ", "->", " ", 
            RowBox[{"Opacity", "[", 
             RowBox[{"0.3", ",", " ", "Blue"}], "]"}]}], ",", "\n", "    ", 
           RowBox[{"PlotLabel", " ", "->", " ", 
            RowBox[{"\"\<Case \>\"", " ", "<>", " ", 
             RowBox[{"ToString", "[", "caseNum", "]"}], " ", "<>", " ", 
             "\"\<: \>\"", " ", "<>", " ", "description"}]}], ",", "\n", 
           "    ", 
           RowBox[{"AxesLabel", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ToString", "[", "var", "]"}], ",", " ", 
              RowBox[{"\"\<f(\>\"", " ", "<>", " ", 
               RowBox[{"ToString", "[", "var", "]"}], " ", "<>", " ", 
               "\"\<)\>\""}]}], "}"}]}], ",", "\n", "    ", 
           RowBox[{"PlotTheme", " ", "->", " ", "\"\<Scientific\>\""}], ",", 
           "\n", "    ", 
           RowBox[{"ImageSize", " ", "->", " ", "400"}]}], "]"}]}], ";", "\n",
         "  ", "\n", "  ", 
        RowBox[{"Print", "[", "plot", "]"}], ";", "\n", "  ", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Exact value: \>\"", ",", " ", "exact"}], "]"}], ";", 
        "\n", "  ", 
        RowBox[{"Print", "[", "]"}], ";", "\n", "  ", "\n", "  ", 
        RowBox[{"Return", "[", "exact", "]"}]}]}], "\n", "]"}]}], ";"}], "\n",
    "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Case", " ", "1"}], ":", " ", 
     RowBox[{
      RowBox[{"Simple", " ", "integral"}], " ", "-", " ", 
      RowBox[{"sin", 
       RowBox[{"(", "x", ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"exact1", " ", "=", " ", 
     RowBox[{"computeIntegral", "[", 
      RowBox[{
       RowBox[{"Sin", "[", "x", "]"}], ",", " ", "x", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "Pi"}], "}"}], ",", " ", "1", ",", " ", 
       "\"\<\[Integral]\:2080^\[Pi] sin(x) dx\>\""}], "]"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Case", " ", "2"}], ":", " ", 
     RowBox[{
