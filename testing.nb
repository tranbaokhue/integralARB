Cell[CellGroupData[{

Cell["Testing on September 10, 2025", "Section",
 CellChangeTimes->{{3.966460849806966*^9, 3.966460856647328*^9}, {
  3.966474585201767*^9, 
  3.966474589762364*^9}},ExpressionUUID->"d60bcc1d-6328-40b7-8758-\
4223cce95bc3"],

Cell["\<\
We will test the precision of integralARB R package with 16 different \
integrals. The answer will range from integers to rational and irrational \
numbers to best evaluate the precision attainable by the package. With this \
Mathematica notebook, we will try to solve each integral symbolically before \
getting the decimal representation in high precision to minimize errors in \
computation.\
\>", "Text",
 CellChangeTimes->{{3.9664608595466003`*^9, 3.966460974747651*^9}, {
  3.966473623547279*^9, 
  3.966473623775834*^9}},ExpressionUUID->"c18ed33a-7b24-4afc-ad64-\
f1f1bc1dfd7e"],

Cell["\<\
Split the code by case. Put the overview with all the graph to the beginning.
\
\>", "Text",
 CellChangeTimes->{{3.9664609832582912`*^9, 
  3.966461003146364*^9}},ExpressionUUID->"0725c520-a11e-4aad-a4ed-\
e7ae336a5ad6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Set", " ", "high", " ", "precision", " ", "for", " ", "calculations"}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"$MaxExtraPrecision", " ", "=", " ", "200"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"precision", " ", "=", " ", "50"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Function", " ", "to", " ", "compute", " ", "integral", " ", 
      "symbolically", " ", "first"}], ",", " ", 
     RowBox[{"then", " ", "numerically", " ", "if", " ", "needed"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"computeIntegral", "[", 
      RowBox[{
      "integrand_", ",", " ", "var_", ",", " ", "limits_", ",", " ", 
       "caseNum_", ",", " ", "description_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "symbolic", ",", " ", "exact", ",", " ", "numerical", ",", " ", 
         "plot"}], "}"}], ",", "\n", "  ", "\n", "  ", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<=== Case \>\"", ",", " ", "caseNum", ",", " ", "\"\<: \>\"", 
          ",", " ", "description", ",", " ", "\"\< ===\>\""}], "]"}], ";", 
        "\n", "  ", "\n", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{"Try", " ", "symbolic", " ", "integration", " ", "first"}], 
         " ", "*)"}], "\n", "  ", 
        RowBox[{"symbolic", " ", "=", " ", 
         RowBox[{"Quiet", "[", 
          RowBox[{"Integrate", "[", 
           RowBox[{"integrand", ",", " ", 
            RowBox[{"{", 
             RowBox[{"var", ",", " ", 
              RowBox[{"limits", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
              RowBox[{"limits", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], "]"}]}], ";",
         "\n", "  ", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FreeQ", "[", 
           RowBox[{"symbolic", ",", " ", "Integrate"}], "]"}], ",", "\n", 
          "    ", 
          RowBox[{"(*", " ", 
           RowBox[{"Symbolic", " ", "integration", " ", "succeeded"}], " ", 
           "*)"}], "\n", "    ", 
          RowBox[{
           RowBox[{"exact", " ", "=", " ", 
            RowBox[{"N", "[", 
             RowBox[{"symbolic", ",", " ", "precision"}], "]"}]}], ";", "\n", 
           "    ", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Symbolic result: \>\"", ",", " ", "symbolic"}], 
            "]"}], ";", "\n", "    ", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<High precision value: \>\"", ",", " ", "exact"}], 
            "]"}]}], ",", "\n", "    ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"Symbolic", " ", "failed"}], ",", " ", 
            RowBox[{
             RowBox[{"use", " ", "high"}], "-", 
             RowBox[{"precision", " ", "numerical"}]}]}], " ", "*)"}], "\n", 
          "    ", 
          RowBox[{
           RowBox[{"exact", " ", "=", " ", 
            RowBox[{"NIntegrate", "[", 
             RowBox[{"integrand", ",", " ", 
              RowBox[{"{", 
               RowBox[{"var", ",", " ", 
                RowBox[{"limits", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                RowBox[{"limits", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", " ", "\n", 
              "           ", 
              RowBox[{"WorkingPrecision", " ", "->", " ", "precision"}]}], 
             "]"}]}], ";", "\n", "    ", 
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<Symbolic integration failed, using numerical: \>\"", ",", 
             " ", "exact"}], "]"}]}]}], "\n", "  ", "]"}], ";", "\n", "  ", 
        "\n", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{"Create", " ", "plot"}], " ", "*)"}], "\n", "  ", 
        RowBox[{"plot", " ", "=", " ", 
         RowBox[{"Plot", "[", 
          RowBox[{"integrand", ",", " ", 
           RowBox[{"{", 
            RowBox[{"var", ",", " ", 
             RowBox[{"limits", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
             RowBox[{"limits", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", " ", "\n", "    ", 
           RowBox[{"PlotStyle", " ", "->", " ", "Purple"}], ",", " ", "\n", 
           "    ", 
