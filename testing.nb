       RowBox[{"Exp", "[", "x", "]"}], ",", " ", "x", ",", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "10"}], ",", " ", "0"}], "}"}], ",", " ", "7", ",", 
       " ", "\"\<\[Integral]\:208b\:2081\:2080\:2070 e\:02e3 dx\>\""}], 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Case", " ", "8"}], ":", " ", 
