       "\"\<\[Integral] cosh(x) dx\>\""}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Case", " ", "6"}], ":", " ", 
     RowBox[{"Polynomial", " ", "integral"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"exact6", " ", "=", " ", 
