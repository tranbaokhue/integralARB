#!/bin/sh

echo "Configuring integralARB..."

PKG_CPPFLAGS=""
PKG_LIBS=""

# First try pkg-config
if command -v pkg-config >/dev/null 2>&1; then
    if pkg-config --exists flint 2>/dev/null; then
        echo "Found FLINT via pkg-config"
        PKG_CPPFLAGS="`pkg-config --cflags flint` -I./include -DHAVE_FLINT"
        PKG_LIBS="`pkg-config --libs flint`"
    fi
fi

# Manual detection if pkg-config failed
if test -z "$PKG_CPPFLAGS"; then
    echo "Trying manual detection..."

    for prefix in /opt/homebrew /usr/local /opt/local /usr; do
        if test -f "$prefix/include/flint/flint.h"; then
            echo "Found FLINT in $prefix"
            PKG_CPPFLAGS="-I$prefix/include -I./include -DHAVE_FLINT"
            PKG_LIBS="-L$prefix/lib -lflint -lgmp -lmpfr -lm"
            break
        fi
    done
fi

if test -z "$PKG_CPPFLAGS"; then
    echo "Error: FLINT not found. Please install FLINT:"
    echo "  macOS: brew install flint"
    echo "  Ubuntu: sudo apt-get install libflint-dev"
    exit 1
fi

# Create Makevars
cat > src/Makevars << EOF
PKG_CPPFLAGS = $PKG_CPPFLAGS
PKG_LIBS = $PKG_LIBS
OBJECTS = init.o r_interface.o builtin_functions.o
PKG_CFLAGS = -DHAVE_VISIBILITY_ATTRIBUTE
EOF

echo "Configuration complete"
echo "CPPFLAGS: $PKG_CPPFLAGS"
echo "LIBS: $PKG_LIBS"
