#!/bin/sh

echo "Configuring integralARB..."

PKG_CPPFLAGS=""
PKG_LIBS=""

# Try pkg-config first
if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists flint 2>/dev/null; then
    echo "Found FLINT via pkg-config"
    PKG_CPPFLAGS="`pkg-config --cflags flint` -I./include -DHAVE_FLINT"
    PKG_LIBS="`pkg-config --libs flint`"

    # Add system library path for Ubuntu
    if test "$(uname)" = "Linux"; then
        PKG_LIBS="$PKG_LIBS -Wl,-rpath,/usr/lib/x86_64-linux-gnu"
    fi
else
    echo "pkg-config failed, trying manual detection..."
    # Manual fallback
    for prefix in /opt/homebrew /usr/local /usr; do
        if test -f "$prefix/include/flint/flint.h"; then
            echo "Found FLINT in $prefix"
            PKG_CPPFLAGS="-I$prefix/include -I./include -DHAVE_FLINT"
            PKG_LIBS="-L$prefix/lib -lflint -lgmp -lmpfr"
            if test "$(uname)" = "Linux"; then
                PKG_LIBS="$PKG_LIBS -Wl,-rpath,$prefix/lib"
            fi
            break
        fi
    done
fi

if test -z "$PKG_CPPFLAGS"; then
    echo "Error: FLINT not found"
    exit 1
fi

cat > src/Makevars << EOF
PKG_CPPFLAGS = $PKG_CPPFLAGS
PKG_LIBS = $PKG_LIBS
OBJECTS = init.o r_interface.o builtin_functions.o
PKG_CFLAGS = -DHAVE_VISIBILITY_ATTRIBUTE
EOF

echo "Configuration complete"
